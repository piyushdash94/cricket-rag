# Copy to .env (git-ignored). Shell variables win.
# Your cricbot checkout; its data/cricbot.duckdb is opened read-only.
CRICBOT_ROOT=C:\path\to\cricbot
# Free key from https://console.groq.com (if unset, cricbot's backend/.env is used)
GROQ_API_KEY=
# Optional
# FIELDING_EVENTS=C:\path\to\ipl_fielding\output\fielding_events.csv   # audited drops/misfields
# GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b                       # writer + SQL finder
# GROQ_INTENT_MODEL=openai/gpt-oss-20b,qwen/qwen3.8-27b                 # intent form
# ROUTER=intent                                                          # or rules
# GROQ_MAX_WAIT=65                                                       # seconds to wait on a rate limit
# AGENT=graph                                                           # graph (relational branch + Pandit) or pandit
# CRICSHEET_XI=data\cricsheet_xi.csv                                    # from `cricrag export-xi`: full XIs for name matching
# CRICSHEET_REGISTER=C:\path\to\cricbot\data\cricsheet_people.csv   # Cricsheet people.csv (default: next to cricbot.duckdb)
